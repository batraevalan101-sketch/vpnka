{
  "name": "client-proto",
  "version": "0.1.0",
  "description": "Desktop client prototype",
  "author": "me",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.client.proto",
    "productName": "ClientProto",
    "files": ["main.js", "index.html", "build/icon.png"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "portable": { "artifactName": "ClientProto-portable.exe" },
    "nsis": { "artifactName": "ClientProto-Setup.exe", "oneClick": true }
  }
}
